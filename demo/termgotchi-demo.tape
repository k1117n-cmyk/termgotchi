Output assets/termgotchi-demo.gif

Require zsh
Require jq

Set Shell "zsh"
Set Width 1200
Set Height 760
Set FontSize 28
Set FontFamily "Menlo"
Set TypingSpeed 45ms
Set Padding 28
Set Framerate 30
Set Theme "Builtin Dark"
Set CursorBlink false

Type "zsh /Users/noi/termgotchi/demo/termgotchi-demo.zsh"
Enter
Sleep 25s
